# Server Port
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aljama?schema=public"

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SMTP)
# Option 1: Local Mailpit (Docker port 1025, Web UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AL-JAMA Notifications <noreply@aljama.local>"

# Option 2: Real Gmail SMTP (requires 16-character App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="AL-JAMA Notifications <your_email@gmail.com>"

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
